{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "schemas/**/*",
    "collector/**/*",
    "tests/**/*",
    "worker/**/*",
    "functions/**/*",
    "agent/**/*"
  ]
}
